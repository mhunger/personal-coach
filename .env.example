# Copy to .env and fill in. Never commit .env.

# --- Anthropic -----------------------------------------------------------
ANTHROPIC_API_KEY=

# --- MySQL ---------------------------------------------------------------
MYSQL_DATABASE=personal_coach
MYSQL_USER=coach
MYSQL_PASSWORD=coach
MYSQL_ROOT_PASSWORD=root

# --- Backend -------------------------------------------------------------
# Spring uses these; the sidecar URL is reached over the docker-compose network.
BACKEND_PORT=8080
COACH_SIDECAR_URL=http://coach-sidecar:8000

# --- Sidecar -------------------------------------------------------------
# Where the sidecar can reach the backend to read/write data.
BACKEND_URL=http://backend:8080
